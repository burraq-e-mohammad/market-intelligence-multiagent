# =====================================================================
# FREE MULTI-AGENT INTELLIGENCE CONFIGURATION
# 100% Free - You can run this with ZERO keys (Mock mode), or with 
# completely free API tiers (Gemini Free Tier, Groq Free Tier, or Ollama).
# =====================================================================

# Select your preferred LLM provider: 'gemini', 'groq', 'ollama', or 'mock'
LLM_PROVIDER=mock

# OPTION 1: Google Gemini API (Free tier from https://aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OPTION 2: Groq Cloud (Free tier from https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OPTION 3: Ollama (100% Offline & Free, runs locally on your computer)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3
